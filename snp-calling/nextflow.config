// Generic HPC configuration. Use with: nextflow run <script>.nf -profile slurm,singularity
// (or -profile pbs,conda, -profile local,docker, ...). Executor and container profiles are combinable.

params {
  input_dir = "${projectDir}/input"        // expects data/ subfolder (see pipeline scripts)
  outdir    = "${launchDir}/results"
}

workDir = "${launchDir}/work"

process {
  shell = ['/bin/bash', '-ue']
  errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
  maxRetries = 2

  // Tool images used when a container profile is enabled; adjust to your site/registry
  withName: '.*BWA.*'            { container = 'quay.io/biocontainers/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:219b6c272b25e7e642ae3ff0bf0c5c81a5135ab4-0' }
  withName: '.*SAMTOOLS.*'       { container = 'quay.io/biocontainers/samtools:1.20--h50ea8bc_0' }
  withName: '.*HAPLOTYPECALLER.*|.*JOINTGENOTYPING.*|.*GATK.*' { container = 'broadinstitute/gatk:4.5.0.0' }
  withName: '.*MULTIQC.*'        { container = 'quay.io/biocontainers/multiqc:1.25--pyhdfd78af_0' }
}

profiles {
  local {
    process.executor = 'local'
  }

  slurm {
    process.executor = 'slurm'
    // process.queue = 'normal'                   // site partition
    // process.clusterOptions = '--account=myproj'
    executor.queueSize = 50
    executor.submitRateLimit = '10 sec'
  }

  pbs {
    process.executor = 'pbspro'                    // use 'pbs' for Torque
    // process.queue = 'workq'
    executor.queueSize = 50
  }

  sge {
    process.executor = 'sge'
    // process.penv = 'smp'
    // process.queue = 'all.q'
  }

  lsf {
    process.executor = 'lsf'
    // process.queue = 'normal'
  }

  singularity {
    singularity.enabled    = true
    singularity.autoMounts = true
    singularity.cacheDir   = "${System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${launchDir}/.singularity"}"
    docker.enabled = false
  }

  apptainer {
    apptainer.enabled    = true
    apptainer.autoMounts = true
    apptainer.cacheDir   = "${System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${launchDir}/.apptainer"}"
  }

  docker {
    docker.enabled = true
    docker.runOptions = '-u $(id -u):$(id -g)'
  }

  // Disable containers and rely on tools in PATH / environment modules
  nocontainer {
    process.container = null
  }
}

report {
  enabled   = true
  file      = "${params.outdir}/reports/report.html"
  overwrite = true
}

trace {
  enabled   = true
  file      = "${params.outdir}/reports/trace.txt"
  overwrite = true
}

timeline {
  enabled   = true
  file      = "${params.outdir}/reports/timeline.html"
  overwrite = true
}

dag {
  enabled   = true
  file      = "${params.outdir}/reports/dag.png"
  overwrite = true
}
