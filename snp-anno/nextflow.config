params {
  input_dir = "${projectDir}/input"
  outdir = "${launchDir}/results/snp-anno"
  snp_calling_results = "${launchDir}/results/snp-calling"
  snpeff_db_store = "${launchDir}/results/snpeff_db"
  input_subdir = ''
}

workDir = "${launchDir}/work/snp-anno"

process {
  shell = ['/bin/bash', '-ue']
  errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
  maxRetries = 2
  withName: 'PREPARE_VCF|EMS_REPORT' { container = 'quay.io/biocontainers/bcftools:1.20--h8b25389_0' }
  withName: 'SNPEFF_BUILD|SNPEFF_ANNOTATE|SNPSIFT_EXTRACT' { container = 'quay.io/biocontainers/snpeff:5.2--hdfd78af_0' }
  withName: 'ANNOTATION_QC_REPORT' { container = 'python:3.12-slim' }
}

profiles {
  local { process.executor = 'local' }
  slurm {
    process.executor = 'slurm'
    executor.queueSize = 50
    executor.submitRateLimit = '10 sec'
  }
  pbs {
    process.executor = 'pbspro'
    executor.queueSize = 50
  }
  sge { process.executor = 'sge' }
  lsf { process.executor = 'lsf' }
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    singularity.cacheDir = "${System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${launchDir}/.singularity"}"
    docker.enabled = false
  }
  apptainer {
    apptainer.enabled = true
    apptainer.autoMounts = true
    apptainer.cacheDir = "${System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${launchDir}/.apptainer"}"
  }
  docker {
    docker.enabled = true
    docker.runOptions = '-u $(id -u):$(id -g)'
  }
  nocontainer { process.container = null }
}

report { enabled = true; file = "${params.outdir}/reports/report.html"; overwrite = true }
trace { enabled = true; file = "${params.outdir}/reports/trace.txt"; overwrite = true }
timeline { enabled = true; file = "${params.outdir}/reports/timeline.html"; overwrite = true }
dag { enabled = true; file = "${params.outdir}/reports/dag.png"; overwrite = true }